# Configure variables in the process environment. This file is NOT loaded automatically.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bugambilia
DB_USER=bugambilia_app
DB_PASSWORD=REPLACE_OUTSIDE_GIT
APP_RUNTIME=C:/private/bugambilia-runtime
# Production: HTTPS required. Local loopback tests only: ALLOW_LOCAL_HTTP=1
ALLOW_LOCAL_HTTP=0
